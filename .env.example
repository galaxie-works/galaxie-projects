# Chave mestra que cifra as chaves de API de IA de cada empresa (Ajustes).
# Só no servidor, nunca com prefixo NEXT_PUBLIC_. Mínimo 32 caracteres.
# Gere com: openssl rand -base64 48
# Se for trocada, as chaves já salvas deixam de abrir e precisam ser cadastradas de novo.
IA_CHAVE_MESTRA=
# Cobrança (Stripe) e IA inclusa no plano
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
